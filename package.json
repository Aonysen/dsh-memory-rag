{
  "name": "dsh-memory-rag",
  "version": "1.0.0",
  "description": "Provider-agnostic RAG memory for DeepSeek Harness: semantic search, note writes, batch ingest, session index injection, and a Settings page for any OpenAI-compatible embedding endpoint.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "aonysen (https://github.com/aonysen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aonysen/dsh-memory-rag.git"
  },
  "homepage": "https://github.com/aonysen/dsh-memory-rag#readme",
  "bugs": {
    "url": "https://github.com/aonysen/dsh-memory-rag/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "rag",
    "memory",
    "embedding",
    "vector-search",
    "qwen",
    "openai-compatible",
    "ollama"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
